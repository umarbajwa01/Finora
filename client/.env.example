# Backend API base URL (see server/.env.example for the matching backend port)
VITE_API_URL=http://localhost:5000/api

# When "true" (default if unset), the app runs entirely on mock/demo data with
# no backend required — useful for previewing the UI. Set to "false" once your
# backend is running and you want the app to hit real endpoints.
VITE_USE_MOCK=true

# Google Sign-In Client ID from Google Cloud Console (OAuth 2.0 Client IDs,
# type "Web application"). Leave empty to show a demo-only Google button
# instead of the real Google Identity Services widget.
VITE_GOOGLE_CLIENT_ID=605352841258-s5g3j4fajapl4tuih5poktgviu4bpvsq.apps.googleusercontent.com
